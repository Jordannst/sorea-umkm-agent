# SOREA UMKM Agent - Environment Example
# Copy to .env only on your own machine/server.
# Do NOT commit real secrets.

# Dashboard / MCP integration
DASHBOARD_URL=https://umkm-finance-dashboard.vercel.app
LIANA_SHARED_SECRET=<set-your-dashboard-shared-secret>
BUSINESS_ID=<set-your-business-uuid>
OPENCLAW_HOOK_TOKEN=<set-your-openclaw-hook-token>

# Telegram notification / bot integration, optional depending on runtime
TELEGRAM_BOT_TOKEN=<set-your-telegram-bot-token>
OPENCLAW_TELEGRAM_BOT_TOKEN=<set-your-openclaw-telegram-bot-token-if-used>

# Payment provider config lives in the dashboard project.
# These are shown only so readers understand required integration variables.
PAKASIR_PROJECT_ID=<set-your-pakasir-project-id-in-dashboard>
PAKASIR_API_KEY=<set-your-pakasir-api-key-in-dashboard>
PAKASIR_API_URL=https://app.pakasir.com

# OpenClaw / MCP local path example
UMKM_FINANCE_MCP_SERVER=/absolute/path/to/liana-mcp/server.mjs
